# Confirmed from the DJI C-board schematic/manual.
MCU=STM32F407IGH6
HSE_HZ=12000000

# Planned assignments. Device-node numbers are resolved by the BSP later.
NSH_CONSOLE=USART6
NSH_TX_PIN=PG14
NSH_RX_PIN=PG9

SBUS_UART=USART3
SBUS_RX_PIN=PC11
SBUS_BAUD=100000
SBUS_FORMAT=8E2
SBUS_EXTERNAL_INVERTER=board-populated

MAVLINK_UART=USART1
MAVLINK_TX_PIN=PA9
MAVLINK_RX_PIN=PB7

PRIMARY_MOTOR_CAN=CAN1
CAN1_TX_PIN=PD1
CAN1_RX_PIN=PD0
CAN_BITRATE=1000000

SECONDARY_CAN=CAN2
CAN2_TX_PIN=PB6
CAN2_RX_PIN=PB5

PWM_TIMER_1=TIM1
PWM_TIMER_8=TIM8

# The exact sectors are selected only after the linker map is validated.
PARAM_FLASH_LAYOUT=UNASSIGNED
