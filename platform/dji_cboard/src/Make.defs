# SPDX-License-Identifier: Apache-2.0

CSRCS = stm32_boot.c stm32_bringup.c

ifeq ($(CONFIG_CAN),y)
CSRCS += stm32_can.c
endif

ifeq ($(CONFIG_ARCH_LEDS),y)
CSRCS += stm32_autoleds.c
endif

ifeq ($(CONFIG_ARCH_BUTTONS),y)
CSRCS += stm32_buttons.c
endif

ifeq ($(CONFIG_ETC_ROMFS),y)
CSRCS += etc_romfs.c
endif
