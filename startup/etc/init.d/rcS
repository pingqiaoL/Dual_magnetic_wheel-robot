#! /bin/nsh
# Continue so RobotRuntime can report every failed module.
set +e

echo "Starting CBoard robot runtime"
robot start

echo "Selecting numbered robot profile"
source /etc/init.d/rc.autostart

echo "Starting RC channel processing"
rc_update start

echo "Starting MK32 SBUS input"
sbus_input start -d /dev/ttyS2

echo "Starting RC loss failsafe"
failsafe start

echo "Starting robot setpoint generation"
robot_control start

echo "Starting control allocation"
control_allocator start

echo "Starting CAN output"
can_output start -d /dev/can0

echo "Starting RC safety management"
command start
